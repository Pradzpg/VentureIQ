const Onboarding = ({ onComplete, initialData = null, userId }) => {
  const standardIndustries = [
    "Agriculture", 
    "AgriTech", 
    "Construction", 
    "EdTech", 
    "Education", 
    "Energy", 
    "Finance", 
    "FinTech", 
    "Gaming", 
    "Healthcare", 
    "HealthTech", 
    "Hospitality", 
    "Manufacturing", 
    "Media and Entertainment", 
    "Technology/AI", 
    "Transportation"
  ];

  let initialSector = initialData?.sector || '';
  let initialCustomSector = '';
  if (initialSector && !standardIndustries.includes(initialSector)) {
    initialCustomSector = initialSector;
    initialSector = 'Other';
  }

  const [step, setStep] = useState(1);
  const [isProcessing, setIsProcessing] = useState(false);
  const [formData, setFormData] = useState({
    name: initialData?.name || '', 
    description: initialData?.description || '', 
    problem: initialData?.problem || '',
    solution: initialData?.solution || '',
    targetAudience: initialData?.targetAudience || '',
    sector: initialSector, 
    customSector: initialCustomSector,
    stage: initialData?.stage || '', 
    teamSize: initialData?.teamSize || '',
    specialBackground: initialData?.specialBackground || '',
    website: initialData?.website || ''
  });
  const [error, setError] = useState('');

  const handleInputChange = (field, value) => {
    setFormData(prev => ({ ...prev, [field]: value }));
    setError('');
  };

  const handleNext = async () => {
    // Validation per step
    if (step === 1 && (!formData.name.trim() || !formData.description.trim())) {
      setError('Please fill out all business identity fields to continue.');
      return;
    }
    if (step === 2 && (!formData.problem.trim() || !formData.solution.trim() || !formData.targetAudience.trim())) {
      setError('Please define your core proposition, problem, and target audience clearly.');
      return;
    }
    if (step === 3) {
       if (!formData.sector || !formData.stage || !formData.teamSize || !formData.specialBackground.trim()) {
         setError('Please complete all market and team profile fields.');
         return;
       }
       if (formData.sector === 'Other' && !formData.customSector.trim()) {
         setError('Please specify your custom industry.');
         return;
       }
    }
    
    setError('');

    if (step < 4) {
      setStep(step + 1);
    } else {
      setIsProcessing(true);
      
      const dataToSave = {
        ...formData,
        sector: formData.sector === 'Other' ? formData.customSector.trim() : formData.sector,
        updatedAt: serverTimestamp()
      };
      delete dataToSave.customSector;
      
      // Save to Firebase
      try {
         await setDoc(doc(db, 'artifacts', appId, 'users', userId, 'profile', 'data'), dataToSave);
         setTimeout(() => onComplete(dataToSave), 2500); 
      } catch (err) {
         console.error("Error saving profile:", err);
         setIsProcessing(false);
         setError("Failed to save profile. Please try again.");
      }
    }
  };

  if (isProcessing) {
    return (
      <div className="min-h-screen bg-slate-900 flex flex-col items-center justify-center text-white">
        <Brain className="w-16 h-16 text-indigo-500 animate-pulse mb-8" />
        <h2 className="text-2xl font-bold mb-4">Building your intelligence profile...</h2>
        <div className="space-y-3 w-64 text-sm text-slate-400">
          <div className="flex items-center gap-3"><CheckCircle2 className="w-4 h-4 text-emerald-500" /> Analysing sector landscape</div>
          <div className="flex items-center gap-3"><CheckCircle2 className="w-4 h-4 text-emerald-500" /> Profiling competitive intelligence</div>
          <div className="flex items-center gap-3 animate-pulse"><Activity className="w-4 h-4 text-indigo-400" /> Calibrating advisory modules</div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 py-20 px-6">
      <div className="max-w-2xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
        <div className="flex justify-between items-center mb-8">
          <span className="text-sm font-bold text-indigo-600 uppercase tracking-wider">Step {step} of 4</span>
          <div className="flex gap-2">
            {[1, 2, 3, 4].map(i => (
              <div key={i} className={`h-2 w-10 rounded-full ${i <= step ? 'bg-indigo-900' : 'bg-slate-200'}`} />
            ))}
          </div>
        </div>

        {error && <div className="mb-6 p-3 bg-red-50 text-red-700 text-sm rounded-lg border border-red-100">{error}</div>}

        {step === 1 && (
          <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4">
            <h2 className="text-3xl font-bold text-slate-900">Business Identity</h2>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Startup Name *</label>
              <input type="text" 
                value={formData.name}
                onChange={(e) => handleInputChange('name', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" 
                placeholder="e.g. Acme Corp" 
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Brief Description (Elevator Pitch) *</label>
              <textarea 
                value={formData.description}
                onChange={(e) => handleInputChange('description', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none h-32 resize-none" 
                placeholder="In 2-3 sentences, what does your startup do?"></textarea>
            </div>
          </div>
        )}

        {step === 2 && (
          <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4">
            <h2 className="text-3xl font-bold text-slate-900">Core Proposition</h2>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Target Audience *</label>
              <input type="text" 
                value={formData.targetAudience}
                onChange={(e) => handleInputChange('targetAudience', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" 
                placeholder="Who are you selling to? (e.g., GenZ Students, Tier-2 Retailers)" 
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">What problem are you addressing? *</label>
              <textarea 
                value={formData.problem}
                onChange={(e) => handleInputChange('problem', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none h-24 resize-none" 
                placeholder="Describe the exact pain point your customers face."></textarea>
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">What is your solution? *</label>
              <textarea 
                value={formData.solution}
                onChange={(e) => handleInputChange('solution', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none h-24 resize-none" 
                placeholder="How does your product/service uniquely solve this problem?"></textarea>
            </div>
          </div>
        )}

        {step === 3 && (
          <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4">
            <h2 className="text-3xl font-bold text-slate-900">Market & Team Profile</h2>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Industry Vertical *</label>
              <select 
                value={formData.sector}
                onChange={(e) => handleInputChange('sector', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none mb-3"
              >
                <option value="">Select an industry...</option>
                {standardIndustries.map(ind => (
                  <option key={ind} value={ind}>{ind}</option>
                ))}
                <option value="Other">Other (Please specify)</option>
              </select>
              
              {formData.sector === 'Other' && (
                <input 
                  type="text" 
                  value={formData.customSector}
                  onChange={(e) => handleInputChange('customSector', e.target.value)}
                  className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none animate-in fade-in slide-in-from-top-2" 
                  placeholder="Enter your specific industry" 
                />
              )}
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-2">Current Stage *</label>
                <select 
                  value={formData.stage}
                  onChange={(e) => handleInputChange('stage', e.target.value)}
                  className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
                >
                  <option value="">Select stage...</option>
                  <option value="Idea">Idea Stage</option><option value="MVP">MVP / Prototype</option><option value="Early">Early Revenue</option><option value="Scaling">Scaling (Series A+)</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-2">Team Size *</label>
                <select 
                  value={formData.teamSize}
                  onChange={(e) => handleInputChange('teamSize', e.target.value)}
                  className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
                >
                  <option value="">Select size...</option>
                  <option value="Solo">Solo Founder</option>
                  <option value="2-5">2-5 members</option>
                  <option value="6-15">6-15 members</option>
                  <option value="16-50">16-50 members</option>
                  <option value="50+">50+ members</option>
                </select>
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Founder / Team Special Background *</label>
              <textarea 
                value={formData.specialBackground}
                onChange={(e) => handleInputChange('specialBackground', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none h-24 resize-none" 
                placeholder="E.g., Alumni of IIT/IIM, ex-Google/Microsoft/HUL, domain experts with 10 years in logistics, or none."></textarea>
            </div>
          </div>
        )}

        {step === 4 && (
          <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4">
            <h2 className="text-3xl font-bold text-slate-900">Digital Office Setup</h2>
            <p className="text-slate-500">Upload your pitch deck, financials, or provide your website URL to configure your digital HQ. (Optional)</p>
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-2">Website URL</label>
              <input type="url" 
                value={formData.website}
                onChange={(e) => handleInputChange('website', e.target.value)}
                className="w-full p-4 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" 
                placeholder="https://..." 
              />
            </div>
            <div className="border-2 border-dashed border-slate-300 rounded-lg p-8 text-center hover:bg-slate-50 transition-colors cursor-pointer group">
              <Upload className="w-8 h-8 text-slate-400 mx-auto mb-3 group-hover:text-indigo-500 transition-colors" />
              <p className="text-sm font-medium text-slate-700">Click to upload documents</p>
              <p className="text-xs text-slate-500 mt-1">PDF, PPTX, XLSX (Max 10MB)</p>
            </div>
          </div>
        )}

        <div className="mt-10 flex justify-end">
          {step > 1 && (
             <button 
                onClick={() => setStep(step - 1)}
                className="bg-white text-slate-600 px-8 py-3 rounded-md font-medium hover:bg-slate-50 border border-slate-200 mr-4"
              >
                Back
