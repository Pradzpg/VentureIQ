          )}
          <button 
            onClick={handleNext}
            className="bg-indigo-900 text-white px-8 py-3 rounded-md font-medium hover:bg-indigo-800 flex items-center gap-2 shadow-md"
          >
            {step === 4 ? (initialData ? 'Update Office' : 'Launch Digital HQ') : 'Continue'} <ChevronRight className="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>
  );
