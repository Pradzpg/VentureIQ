          <aside className="w-64 bg-slate-900 text-slate-300 flex flex-col shrink-0 border-r border-slate-800">
            <div className="p-6 flex items-center gap-2 border-b border-slate-800">
              <div className="w-8 h-8 bg-indigo-600 rounded-sm flex items-center justify-center cursor-pointer" onClick={handleBackToDashboard}>
                <Brain className="text-white w-5 h-5" />
              </div>
              <span className="text-xl font-bold tracking-tight text-white cursor-pointer" onClick={handleBackToDashboard}>VENTURE IQ</span>
            </div>
            
            <div className="flex-1 overflow-y-auto py-6 custom-scrollbar">
              <div className="px-4 mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Workspace</div>
              <button 
                onClick={handleBackToDashboard}
                className={`w-full flex items-center gap-3 px-6 py-3 hover:bg-slate-800 hover:text-white transition-colors ${view === 'dashboard' ? 'bg-slate-800 text-white border-l-2 border-indigo-500' : ''}`}
              >
                <Activity className="w-4 h-4" /> HQ Dashboard
              </button>
              <button 
                onClick={handleEditProfile}
                className={`w-full flex items-center gap-3 px-6 py-3 hover:bg-slate-800 hover:text-white transition-colors`}
              >
                <Settings className="w-4 h-4" /> Edit HQ Context
              </button>
              
              <div className="px-4 mt-8 mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Advisory Modules</div>
              <div className="space-y-1">
                {MODULES.map(mod => (
                  <button 
                    key={mod.id}
                    onClick={() => handleSelectModule(mod)}
                    className={`w-full flex items-center gap-3 px-6 py-2.5 text-sm hover:bg-slate-800 hover:text-white transition-colors ${view === 'module' && activeModule?.id === mod.id ? 'bg-slate-800 text-white' : 'text-slate-400'}`}
                  >
                    <mod.icon className="w-4 h-4 shrink-0" /> <span className="truncate">{mod.title}</span>
                  </button>
                ))}
              </div>
            </div>
            
            <div className="p-6 border-t border-slate-800 flex items-center justify-between group cursor-pointer hover:bg-slate-800 transition-colors" onClick={handleSignOut}>
              <div className="flex items-center gap-3 overflow-hidden">
                 <div className="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-white font-bold shrink-0">
                    {userProfile?.name?.charAt(0)?.toUpperCase() || 'F'}
                 </div>
                 <div className="overflow-hidden">
                   <p className="text-sm font-medium text-white truncate">{userProfile?.name || 'Founder'}</p>
                   <p className="text-xs text-slate-500 truncate">{user?.email || 'Logged In'}</p>
                 </div>
              </div>
              <LogOut className="w-4 h-4 text-slate-500 group-hover:text-white shrink-0" title="Sign Out" />
            </div>
          </aside>

          <main className="flex-1 flex flex-col min-w-0 bg-white relative">
             {view === 'dashboard' && <Dashboard onSelectModule={handleSelectModule} userProfile={userProfile} />}
             {view === 'module' && activeModule && (
               <AdvisoryModule module={activeModule} onBack={handleBackToDashboard} userProfile={userProfile} userId={user?.uid} />
             )}
          </main>
        </div>
      )}
    </div>
  );
}
