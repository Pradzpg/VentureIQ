const AdvisoryModule = ({ module, onBack, userProfile, userId }) => {
  const [messages, setMessages] = useState([]);
  const [apiHistory, setApiHistory] = useState([]);
  const [inputValue, setInputValue] = useState('');
  const [showUrlInput, setShowUrlInput] = useState(false);
  const [urlValue, setUrlValue] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const [isGeneratingDoc, setIsGeneratingDoc] = useState(false);
  const textareaRef = useRef(null);
  const scrollContainerRef = useRef(null);

  const systemPrompt = `You are a top-tier Strategy Consultant acting as the ${module.persona} for a startup named ${userProfile?.name || 'the startup'}.
  Startup Context:
  - Sector: ${userProfile?.sector}
  - Problem they solve: ${userProfile?.problem}
  - Solution: ${userProfile?.solution}
  - Target Audience: ${userProfile?.targetAudience}
  - Stage: ${userProfile?.stage}
  - Team: ${userProfile?.teamSize}, Background: ${userProfile?.specialBackground}

  Your Directives:
  1. Role: Provide professional, highly specialized guidance within YOUR domain (${module.title}). Use the Google Search tool to ensure your advice is backed by real-time data.
  2. Capabilities: Strategize, provide Research & Insights, and Ideate. Help the user think broadly but also drill down into concrete decision-making.
  3. Tone & Approach: Be straightforward. Critically analyze loopholes, limitations, and risks in the user's decisions. Appreciate good decisions when appropriate. Give practical angles and diverse perspectives.
  4. Interaction: Always end your response with the right, highly targeted follow-up questions to gain a better understanding and drive the strategy forward.
  5. Module Routing: If the user asks about a topic outside ${module.title}, politely redirect them to the correct module (e.g., Marketing, Finance, Org Design).
  6. Formatting: Use clean paragraphs. Use **bolding** for emphasis and key terms. Do not use markdown headers (#).`;

  // ============================================================================
  // AI ROUTING GATEWAY (Production Architecture)
  // In production, move these calls to Supabase Edge Functions or Make.com
  // ============================================================================
  
  const callIntelligenceEngine = async (history, currentMessage, intent = 'advisory') => {
    // 1. CLAUDE OPUS (Document Generation & Large File Analysis)
    if (intent === 'document_generation' || currentMessage.includes('[Attached File]')) {
       console.log("Routing to: Claude Opus (claude-3-opus-20240229) for deep document analysis/generation.");
       /* 
       return await fetch('https://api.anthropic.com/v1/messages', {
         method: 'POST',
         headers: { 'x-api-key': process.env.ANTHROPIC_API_KEY, 'anthropic-version': '2023-06-01', 'content-type': 'application/json' },
         body: JSON.stringify({ model: 'claude-3-opus-20240229', max_tokens: 4096, messages: history })
       }); 
       */
    }

    // 2. PERPLEXITY SONAR PRO (Real-time Macro Data)
    if (intent === 'real_time_research') {
       console.log("Routing to: Perplexity Sonar Pro (llama-3-sonar-pro-32k-online) for live data.");
       /*
       return await fetch('https://api.perplexity.ai/chat/completions', {
         method: 'POST',
         headers: { 'Authorization': `Bearer ${process.env.PERPLEXITY_API_KEY}`, 'Content-Type': 'application/json' },
         body: JSON.stringify({ model: 'llama-3-sonar-pro-32k-online', messages: history })
       });
       */
    }

    // 3. GPT-5 / GEMINI PRO (High-level Strategic Advisory)
    if (intent === 'advisory') {
       console.log("Routing to: GPT-5 / Gemini Pro for core advisory.");
       /*
       return await fetch('https://api.openai.com/v1/chat/completions', {
         method: 'POST',
         headers: { 'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`, 'Content-Type': 'application/json' },
         body: JSON.stringify({ model: 'gpt-4o', messages: history }) // Upgrade to gpt-5 when available
       });
       */
    }

    // ============================================================================
    // FALLBACK FOR PREVIEW ENVIRONMENT: Gemini 3 Flash
    // We route all calls here securely in the frontend to maintain app functionality
    // ============================================================================
    const apiKey = ""; 
    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
    
    const payload = {
      contents: history,
      systemInstruction: { parts: [{ text: systemPrompt }] },
      tools: [{ "google_search": {} }]
    };

    const response = await fetch(apiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    
    return await response.json();
  };

  useEffect(() => {
    if (!userId || !module.id) return;
    
    let isMounted = true;
    setMessages([]);
    setApiHistory([]);
    
    const initSession = async () => {
      setIsTyping(true);
      const initUserMessage = `Hello. Please introduce yourself as our ${module.persona}. Acknowledge our startup's core solution (${userProfile?.solution}) and target audience (${userProfile?.targetAudience}). Then, provide 2-3 broad, proactive strategic suggestions specifically related to ${module.title} that we should focus on given our current stage (${userProfile?.stage}). End by asking a provocative follow-up question to kick off our session.`;
      
      const historySetup = [{ role: "user", parts: [{ text: initUserMessage }] }];

      try {
        const result = await callIntelligenceEngine(historySetup, initUserMessage, 'advisory');
        const aiText = result.candidates?.[0]?.content?.parts?.[0]?.text || "Hello! I am ready to assist you. What specific challenge are we tackling today?";

        if (isMounted) {
          setMessages([{ role: 'ai', content: aiText }]);
          setApiHistory([
            { role: "user", parts: [{ text: initUserMessage }] },
            { role: "model", parts: [{ text: aiText }] }
          ]);
        }
      } catch (err) {
        console.error("Initialization API Error", err);
        if (isMounted) {
           const fallbackText = `Hello ${userProfile?.name ? userProfile.name + ' team' : 'Founder'}. I am acting as your **${module.persona}**.\n\nI have reviewed your profile. Given you are solving a critical problem for **${userProfile?.targetAudience || 'your target audience'}** at the ${userProfile?.stage} stage, let's look at some broad strategies.\n\nWhat specific challenge within my domain are we tackling today?`;
           setMessages([{ role: 'ai', content: fallbackText }]);
           setApiHistory([{ role: "model", parts: [{ text: fallbackText }] }]);
        }
      } finally {
        if (isMounted) setIsTyping(false);
      }
    };
    
    initSession();
    
    return () => { isMounted = false; };
  }, [module.id]);

  const handleInput = (e) => {
    setInputValue(e.target.value);
    if (textareaRef.current) {
      textareaRef.current.style.height = 'auto';
      textareaRef.current.style.height = `${Math.min(textareaRef.current.scrollHeight, 200)}px`;
    }
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  };

  const scrollToBottom = () => {
    if (scrollContainerRef.current) {
        const container = scrollContainerRef.current;
        container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
    }
  };

  useEffect(() => { scrollToBottom(); }, [messages, isTyping, isGeneratingDoc]);

  const handleSend = async () => {
    const text = inputValue.trim();
    const url = urlValue.trim();
    if (!text && !url) return;

    let userMessage = text;
    if (url) {
      userMessage = userMessage ? `[Attached URL: ${url}]\n${userMessage}` : `[Attached URL: ${url}]`;
    }

    setMessages(prev => [...prev, { role: 'user', content: userMessage }]);
    setInputValue('');
    setUrlValue('');
    setShowUrlInput(false);
    setIsTyping(true);
    
    if (textareaRef.current) textareaRef.current.style.height = 'auto';

    const newUserMsg = { role: "user", parts: [{ text: userMessage }] };
    const currentHistory = [...apiHistory, newUserMsg];
    setApiHistory(currentHistory);

    try {
      // Intent mapping: If user asks for macro data, we route to Perplexity. Otherwise, Advisory.
      const intent = userMessage.toLowerCase().includes('research') || userMessage.toLowerCase().includes('data') 
        ? 'real_time_research' 
        : 'advisory';

      const result = await callIntelligenceEngine(currentHistory, userMessage, intent);
      const aiText = result.candidates?.[0]?.content?.parts?.[0]?.text || "I apologize, I am having trouble processing that right now. Could you rephrase?";

      setMessages(prev => [...prev, { role: 'ai', content: aiText }]);
      setApiHistory(prev => [...prev, { role: "model", parts: [{ text: aiText }] }]);
    } catch (err) {
      console.error("API Error", err);
      setMessages(prev => [...prev, { role: 'ai', content: "Connection error. Please check your network and try again." }]);
      setApiHistory(apiHistory);
    } finally {
      setIsTyping(false);
    }
  };

  const handleGenerateDocument = async () => {
    setIsGeneratingDoc(true);
    
    const docRequestMsg = `Please generate a comprehensive, structured ${module.title} document based on our conversation above. Format it professionally with clear headings.`;
    setMessages(prev => [...prev, { role: 'user', content: "Generate structured document based on our session..." }]);
    
    const newUserMsg = { role: "user", parts: [{ text: docRequestMsg }] };
    const currentHistory = [...apiHistory, newUserMsg];
    setApiHistory(currentHistory);

    try {
      // Explicitly route to Claude Opus logic for heavy document generation
      const result = await callIntelligenceEngine(currentHistory, docRequestMsg, 'document_generation');
      const aiText = result.candidates?.[0]?.content?.parts?.[0]?.text || "Document generation complete.";

      setMessages(prev => [...prev, { role: 'ai', content: aiText, isDocument: true }]);
      setApiHistory(prev => [...prev, { role: "model", parts: [{ text: aiText }] }]);
    } catch (err) {
      console.error("API Error", err);
      setMessages(prev => [...prev, { role: 'ai', content: "Failed to generate document." }]);
    } finally {
      setIsGeneratingDoc(false);
    }
  };

  const formatAiMessage = (text, isDocument = false) => {
    return text.split('\n').map((line, i) => {
      if (line.trim() === '') return null;
      
      const parts = line.split(/\*\*(.*?)\*\*/g);
      
      const formattedLine = (
        <p key={i} className={`mb-3 ${isDocument ? 'text-slate-800' : 'text-slate-700'} leading-relaxed text-justify`}>
          {parts.map((part, j) => {
            if (j % 2 === 1) { 
              return <strong key={j} className="font-bold text-slate-900">{part}</strong>;
            }
            const italicParts = part.split(/\*(.*?)\*/g);
            if (italicParts.length > 1) {
              return italicParts.map((ip, k) => {
                if (k % 2 === 1) return <em key={k} className="italic text-slate-800">{ip}</em>;
                return <span key={k}>{ip}</span>;
              });
            }
            return <span key={j}>{part}</span>;
          })}
        </p>
      );

      return formattedLine;
    });
  };

  return (
    <div className="flex flex-col h-full bg-white relative">
      <div className="shrink-0 flex items-center justify-between p-4 border-b border-slate-200 bg-white z-10 shadow-sm">
        <div className="flex items-center gap-4">
          <div className="w-10 h-10 bg-indigo-50 rounded-lg flex items-center justify-center shrink-0">
            <module.icon className="w-5 h-5 text-indigo-600" />
          </div>
          <div>
            <h2 className="font-bold text-slate-900 leading-tight">{module.title}</h2>
            <p className="text-xs text-slate-500 font-medium">Session with: {module.persona} • (Multi-Model Architecture Active)</p>
          </div>
        </div>
        <div className="flex gap-2">
          <button onClick={handleGenerateDocument} disabled={isTyping || isGeneratingDoc} className="text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-md transition-colors disabled:opacity-50 flex items-center gap-2">
            <FileText className="w-4 h-4" /> Export Report
          </button>
          <button onClick={onBack} className="text-sm font-medium text-slate-600 hover:text-slate-900 bg-slate-100 px-3 py-1.5 rounded-md transition-colors">
            Exit Session
          </button>
        </div>
      </div>

      <div className="shrink-0 bg-amber-50 border-b border-amber-100 p-3 text-center text-xs text-amber-800 font-medium z-10">
        AI-generated advisory content. Not binding professional advice. Validate key decisions with domain experts.
      </div>

      <div ref={scrollContainerRef} className="flex-1 overflow-y-auto p-6 md:p-10 bg-slate-50 relative pb-40">
        <div className="max-w-4xl mx-auto space-y-8">
          {messages.map((msg, idx) => (
            <div key={idx} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
              <div className={`max-w-[85%] rounded-2xl p-6 ${
                msg.role === 'user' 
                  ? 'bg-indigo-900 text-white shadow-md' 
                  : msg.isDocument 
                    ? 'bg-white border-2 border-indigo-200 shadow-lg w-full' 
                    : 'bg-white border border-slate-200 shadow-sm'
              }`}>
                {msg.isDocument && (
                  <div className="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
                    <span className="text-xs font-bold text-indigo-600 uppercase tracking-wider flex items-center gap-2">
                      <FileText className="w-4 h-4"/> Generated Document (Routed via Claude Opus Config)
                    </span>
                  </div>
                )}
                {msg.role === 'user' ? (
                  <p className="whitespace-pre-wrap leading-relaxed">{msg.content}</p>
                ) : (
                  <div className="prose prose-sm md:prose-base prose-slate max-w-none">
                    {formatAiMessage(msg.content, msg.isDocument)}
                  </div>
                )}
              </div>
            </div>
          ))}
          {(isTyping || isGeneratingDoc) && (
             <div className="flex justify-start">
               <div className="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex gap-3 items-center">
                 <span className="text-sm text-slate-500 font-medium">
                   {isGeneratingDoc ? 'Drafting document (Claude Opus route)...' : 'Synthesizing response...'}
                 </span>
                 <div className="flex gap-1">
                   <span className="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-bounce"></span>
                   <span className="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-bounce delay-75"></span>
                   <span className="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-bounce delay-150"></span>
                 </div>
               </div>
             </div>
          )}
        </div>
      </div>

      {/* Sticky Input Area */}
      <div className="absolute bottom-0 left-0 w-full bg-gradient-to-t from-slate-50 via-slate-50 to-transparent pt-10 pb-6 px-6 shrink-0 z-20 pointer-events-none">
        <div className="max-w-4xl mx-auto pointer-events-auto">
          
          {/* URL Input Popup */}
          {showUrlInput && (
            <div className="mb-2 bg-white rounded-lg shadow-md border border-slate-200 p-2 flex items-center animate-in slide-in-from-bottom-2">
               <LinkIcon className="w-4 h-4 text-slate-400 ml-2" />
               <input 
                 type="url"
                 value={urlValue}
                 onChange={(e) => setUrlValue(e.target.value)}
                 placeholder="Paste a URL for Perplexity/Claude to analyze..."
                 className="flex-1 p-2 outline-none text-sm bg-transparent"
                 autoFocus
                 onKeyDown={(e) => { if (e.key === 'Enter') handleSend() }}
               />
               <button 
                 onClick={() => setShowUrlInput(false)}
                 className="p-1 text-slate-400 hover:text-slate-600"
               >
                 &times;
               </button>
            </div>
          )}

          <div className="bg-white rounded-2xl shadow-[0_0_40px_rgba(0,0,0,0.08)] border border-slate-200 p-2 flex items-end focus-within:ring-2 focus-within:ring-indigo-500 transition-shadow">
            <div className="flex items-center shrink-0 p-1">
               <label className="cursor-pointer p-2 text-slate-400 hover:text-indigo-600 transition-colors rounded-lg hover:bg-indigo-50" title="Upload Document for Claude Analysis">
                 <Upload className="w-5 h-5" />
                 <input type="file" className="hidden" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx" />
               </label>
               <button 
                 onClick={() => setShowUrlInput(!showUrlInput)}
                 className={`p-2 transition-colors rounded-lg ${showUrlInput ? 'text-indigo-600 bg-indigo-50' : 'text-slate-400 hover:text-indigo-600 hover:bg-indigo-50'}`}
                 title="Add URL context"
               >
                 <LinkIcon className="w-5 h-5" />
               </button>
            </div>
            
            <textarea
              ref={textareaRef}
              value={inputValue}
              onChange={handleInput}
              onKeyDown={handleKeyDown}
              placeholder="Describe your challenge or ask for advice (Shift+Enter for new line)..."
              className="flex-1 max-h-48 min-h-[44px] p-3 resize-none outline-none text-slate-700 bg-transparent placeholder-slate-400 leading-relaxed"
              rows={1}
            />
            <button 
              onClick={handleSend}
              disabled={(!inputValue.trim() && !urlValue.trim()) || isTyping || isGeneratingDoc}
              className="p-3 m-1 bg-indigo-900 text-white rounded-xl hover:bg-indigo-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all shrink-0 shadow-sm"
            >
              <Send className="w-5 h-5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

